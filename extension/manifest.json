{
  "manifest_version": 3,
  "name": "Sifty",
  "version": "0.1.0",
  "description": "Fills the application form on the open page with the answers Sifty prepared. You attach files, give consent and submit.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {"default_title": "Fill with Sifty"},
  "background": {"service_worker": "worker.js"},
  "options_ui": {"page": "options.html", "open_in_tab": true}
}
